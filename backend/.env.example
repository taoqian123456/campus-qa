# 后端安全：JWT 签名密钥（答辩/部署前请改成随机长字符串，可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=dev-secret-change-me

# DeepSeek API 配置（复制本文件为 .env 后填入你的 Key）
# 注册地址：https://platform.deepseek.com （充值 10-20 元足够毕设使用）
DEEPSEEK_API_KEY=sk-你的key写在这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- 向量嵌入模型（必填，RAG 检索靠它把文档/问题转成向量） ----------
# 硅基流动（https://siliconflow.cn 注册，bge-m3 有免费额度）
EMBEDDING_API_KEY=sk-你的硅基流动key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 多模型（可选，不填该模型就不能用） ----------
# 默认使用的对话模型：deepseek / zhipu / dashscope / moonshot / siliconflow / ollama
LLM_PROVIDER=deepseek

# 智谱 GLM（https://open.bigmodel.cn 注册，glm-4-flash 免费）
ZHIPU_API_KEY=sk-你的智谱key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flash

# 阿里通义（https://bailian.console.aliyun.com 开通百炼）
DASHSCOPE_API_KEY=sk-你的通义key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus

# Kimi（https://platform.moonshot.cn）
MOONSHOT_API_KEY=sk-你的kimi key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_CHAT_MODEL=moonshot-v1-8k

# 硅基流动 LLM（已有 EMBEDDING_API_KEY 的话可单独申请或复用同平台 key）
SILICONFLOW_API_KEY=sk-你的硅基流动key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3

# 本地 Ollama（https://ollama.com 安装后 ollama pull qwen2.5:7b）
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ---------- 存储路径（可选，默认 backend/ 下的 campus_qa.db、uploads/、faiss_index/） ----------
# Docker 部署时改这里指向挂载卷（如 DATABASE_URL=sqlite:////data/campus_qa.db）
# DATABASE_URL=sqlite:///./campus_qa.db
# UPLOAD_DIR=./uploads
# FAISS_INDEX_DIR=./faiss_index

# RAG 参数（第 11 天做对比实验时修改这些值）
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=10
MIN_SCORE=0.25

# 检索模式与 RRF 融合权重（hybrid=BM25+向量双路融合（默认，实测命中率显著更高）；vector=纯向量基线）
RETRIEVAL_MODE=hybrid
RRF_W_VECTOR=0.4
RRF_W_BM25=0.6

# 相关度徽章阈值（高/中/低三档判定，高于 HIGH 显示"高"，低于 LOW 显示"低"）
CONFIDENCE_HIGH=0.6
CONFIDENCE_LOW=0.4

# OCR（扫描版 PDF 兜底；1=开启，0=关闭可免装 pypdfium2/rapidocr）
OCR_ENABLED=1
